<Window x:Class="Tedd.MOS65xx.GUI.KeyBindingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key Bindings" Height="660" Width="1000" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <DockPanel Margin="10">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button DockPanel.Dock="Left" Content="Reset to Defaults" Click="ResetDefaults_Click" Padding="10,3" />
                <TextBlock x:Name="PathText" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Width="90" Click="Save_Click" Padding="10,3" Margin="0,0,8,0"
                            ToolTip="Applies the bindings to the running emulator and writes them to disk" />
                    <Button Content="Cancel" Width="90" Click="Cancel_Click" Padding="10,3" IsCancel="True" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer DockPanel.Dock="Right" Width="360" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Joystick" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock Text="Choose which keys make up each joystick. 'Set...' waits for a key press and binds it, replacing whatever that key did before."
                               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6" />
                    <GroupBox Header="Port 1" Padding="4">
                        <Grid x:Name="JoyPanel1" />
                    </GroupBox>
                    <GroupBox Header="Port 2" Padding="4" Margin="0,6,0,0">
                        <Grid x:Name="JoyPanel2" />
                    </GroupBox>

                    <TextBlock Text="Assign an action to a key" FontWeight="Bold" FontSize="14" Margin="0,14,0,4" />
                    <TextBlock Text="Capture a key (or select a row on the left), choose what it should do, then click Add / Assign."
                               TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6" />
                    <GroupBox Padding="6">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Key:" Width="50" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Press key..." Click="CaptureNewKey_Click" Padding="8,2" />
                                <TextBlock x:Name="NewKeyText" Text="(none)" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock x:Name="NewKeyCurrentText" Foreground="Gray" Margin="50,2,0,0" TextWrapping="Wrap" />

                            <RadioButton x:Name="KindKeyRadio" Content="C64 key" GroupName="Kind" IsChecked="True" Margin="0,10,0,3" />
                            <DockPanel Margin="20,0,0,0">
                                <CheckBox x:Name="ShiftBox" DockPanel.Dock="Right" Content="+ SHIFT" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <ComboBox x:Name="C64KeyBox" DisplayMemberPath="Name" />
                            </DockPanel>

                            <RadioButton x:Name="KindJoyRadio" Content="Joystick" GroupName="Kind" Margin="0,10,0,3" />
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox x:Name="JoyPortBox" Width="50">
                                    <ComboBoxItem Content="1" />
                                    <ComboBoxItem Content="2" IsSelected="True" />
                                </ComboBox>
                                <ComboBox x:Name="JoyInputBox" Width="100" Margin="8,0,0,0" />
                            </StackPanel>

                            <RadioButton x:Name="KindSysRadio" Content="System command" GroupName="Kind" Margin="0,10,0,3" />
                            <ComboBox x:Name="SysCommandBox" Margin="20,0,0,0" />

                            <Button Content="Add / Assign" Click="Assign_Click" Padding="10,3" Margin="0,12,0,0" HorizontalAlignment="Right" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button DockPanel.Dock="Right" Content="Remove" Click="Remove_Click" Padding="8,2" Margin="4,0,0,0"
                            ToolTip="Removes the selected binding (Delete)" />
                    <Button DockPanel.Dock="Right" Content="Rebind key..." Click="Rebind_Click" Padding="8,2" Margin="8,0,0,0"
                            ToolTip="Moves the selected action to the next key you press (Enter or double-click)" />
                    <TextBox x:Name="FilterBox" TextChanged="Filter_TextChanged" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Select a row and click 'Rebind key...' (or double-click it / press Enter) to move that action to another physical key. Selecting a row also loads it into the panel on the right, where its action can be changed." />
                <DataGrid x:Name="BindingsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick" PreviewKeyDown="Grid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding KeyName}" Width="140" />
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="130" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DockPanel>

        <Border x:Name="CaptureOverlay" Visibility="Collapsed" Background="#D0202020" Focusable="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <TextBlock x:Name="CaptureText" Foreground="White" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Foreground="LightGray" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Press the key to use. Any key can be captured, including Escape, Tab and the modifier keys." />
                <Button Content="Cancel" Click="CancelCapture_Click" Width="100" Padding="8,3" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
