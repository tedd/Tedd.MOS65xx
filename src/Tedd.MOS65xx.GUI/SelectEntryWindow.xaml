<Window x:Class="Tedd.MOS65xx.GUI.SelectEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select file" Height="360" Width="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Load" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
        <ListView x:Name="List" MouseDoubleClick="List_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Type" Width="60" DisplayMemberBinding="{Binding Type}" />
                    <GridViewColumn Header="Start" Width="70" DisplayMemberBinding="{Binding Start}" />
                    <GridViewColumn Header="End" Width="70" DisplayMemberBinding="{Binding End}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
