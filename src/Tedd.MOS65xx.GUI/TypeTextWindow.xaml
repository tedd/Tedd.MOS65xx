<Window x:Class="Tedd.MOS65xx.GUI.TypeTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Type text into the C64" Height="220" Width="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Text is typed through the KERNAL keyboard buffer. Line breaks produce RETURN." Margin="0,0,0,6" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Type" Width="80" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
        <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Text="LOAD&quot;*&quot;,8,1&#x0a;" />
    </DockPanel>
</Window>
