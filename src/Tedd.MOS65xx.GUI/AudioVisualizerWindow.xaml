<Window x:Class="Tedd.MOS65xx.GUI.AudioVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tedd.MOS65xx.GUI"
        Title="Audio Visualizer (SID)" Height="680" Width="960" MinHeight="480" MinWidth="700"
        Background="#181818" Foreground="#DDDDDD" FontFamily="Consolas" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD" />
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#202020" />
        </Style>
        <Style x:Key="EnvelopeTrack" TargetType="Border">
            <Setter Property="Background" Value="#303030" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="EnvelopeFill" TargetType="Rectangle">
            <Setter Property="Fill" Value="#40E040" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Width" Value="0" />
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock x:Name="StateText" DockPanel.Dock="Right" Text="" />
            <TextBlock x:Name="LevelText" Text="Level: RMS -inf dB   Peak -inf dB" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Top" Text="Oscilloscope (last 1024 mixed samples)" Style="{StaticResource Header}" />
            <Border BorderBrush="#404040" BorderThickness="1">
                <local:ScopeView x:Name="Scope" ClipToBounds="True" />
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Top" Text="Spectrum (1024 point FFT, Hann window, 64 log-spaced bands, 0..-60 dB)" Style="{StaticResource Header}" />
            <Border BorderBrush="#404040" BorderThickness="1">
                <local:SpectrumView x:Name="Spectrum" ClipToBounds="True" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Voice 1" Style="{StaticResource Header}" />
                    <TextBlock x:Name="Voice1Text" />
                    <Border Style="{StaticResource EnvelopeTrack}">
                        <Rectangle x:Name="Voice1Env" Style="{StaticResource EnvelopeFill}" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Voice 2" Style="{StaticResource Header}" />
                    <TextBlock x:Name="Voice2Text" />
                    <Border Style="{StaticResource EnvelopeTrack}">
                        <Rectangle x:Name="Voice2Env" Style="{StaticResource EnvelopeFill}" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Voice 3" Style="{StaticResource Header}" />
                    <TextBlock x:Name="Voice3Text" />
                    <Border Style="{StaticResource EnvelopeTrack}">
                        <Rectangle x:Name="Voice3Env" Style="{StaticResource EnvelopeFill}" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Panel}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Filter / Volume" Style="{StaticResource Header}" />
                    <TextBlock x:Name="FilterText" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
