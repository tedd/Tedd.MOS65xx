<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Tedd.MOS65xx.Maui.Pages"
             x:Class="Tedd.MOS65xx.Maui.Pages.SelectEntryPage"
             x:DataType="pages:SelectEntryPage"
             Title="Select file">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="6">
        <Grid Grid.Row="0" ColumnDefinitions="*,70,80,80" Padding="6,0">
            <Label Grid.Column="0" Text="Name" FontAttributes="Bold" />
            <Label Grid.Column="1" Text="Type" FontAttributes="Bold" />
            <Label Grid.Column="2" Text="Start" FontAttributes="Bold" />
            <Label Grid.Column="3" Text="End" FontAttributes="Bold" />
        </Grid>

        <CollectionView x:Name="List" Grid.Row="1" SelectionMode="Single" SelectionChanged="List_SelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="pages:SelectEntryPage+EntryRow">
                    <Grid ColumnDefinitions="*,70,80,80" Padding="6,3">
                        <Label Grid.Column="0" Text="{Binding Name}" />
                        <Label Grid.Column="1" Text="{Binding Type}" />
                        <Label Grid.Column="2" Text="{Binding Start}" />
                        <Label Grid.Column="3" Text="{Binding End}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Spacing="8">
            <Button Text="Load" WidthRequest="90" Clicked="Ok_Clicked" />
            <Button Text="Cancel" WidthRequest="90" Clicked="Cancel_Clicked" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
