<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tedd.MOS65xx.Maui.Pages.TypeTextPage"
             Title="Type text into the C64">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <Label Grid.Row="0" Text="Text is typed through the KERNAL keyboard buffer. Line breaks produce RETURN." />
        <Editor x:Name="Input" Grid.Row="1" FontFamily="{StaticResource MonoFont}" AutoSize="Disabled" />
        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Spacing="8">
            <Button Text="Type" WidthRequest="90" Clicked="Ok_Clicked" />
            <Button Text="Cancel" WidthRequest="90" Clicked="Cancel_Clicked" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
