<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Tedd.MOS65xx.Maui.Views"
             x:Class="Tedd.MOS65xx.Maui.Pages.CharsetViewerPage"
             Title="Character Set Viewer"
             Loaded="Page_Loaded"
             Unloaded="Page_Unloaded">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Source -->
        <ScrollView Grid.Row="0" Style="{StaticResource ToolBar}">
            <HorizontalStackLayout Spacing="8">
                <Label Text="Show:" VerticalOptions="Center" />
                <Picker x:Name="SourceBox" WidthRequest="240" SelectedIndexChanged="Source_Changed" />
                <Picker x:Name="SetBox" WidthRequest="240" SelectedIndexChanged="Source_Changed">
                    <Picker.Items>
                        <x:String>Set 1 - uppercase / graphics</x:String>
                        <x:String>Set 2 - lowercase / uppercase</x:String>
                        <x:String>Both sets (512 characters)</x:String>
                    </Picker.Items>
                </Picker>
                <Button Text="Refresh" Clicked="Refresh_Clicked" Padding="10,2" />
                <CheckBox x:Name="AutoRefresh" IsChecked="True" VerticalOptions="Center" />
                <Label Text="Auto" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Display options -->
        <ScrollView Grid.Row="1" Style="{StaticResource ToolBar}">
            <HorizontalStackLayout Spacing="8">
                <Label Text="Zoom" VerticalOptions="Center" />
                <Picker x:Name="ZoomBox" WidthRequest="80" SelectedIndexChanged="Display_Changed" />
                <Label Text="Ink" VerticalOptions="Center" />
                <Picker x:Name="InkBox" WidthRequest="130" SelectedIndexChanged="Display_Changed" />
                <Label Text="Paper" VerticalOptions="Center" />
                <Picker x:Name="PaperBox" WidthRequest="130" SelectedIndexChanged="Display_Changed" />
                <CheckBox x:Name="GridBox" IsChecked="True" VerticalOptions="Center" CheckedChanged="Display_Changed" />
                <Label Text="Grid" VerticalOptions="Center" />
                <Button Text="Load charset..." Clicked="Load_Clicked" Padding="10,2" />
                <Button x:Name="ApplyButton" Text="Apply to machine" Clicked="Apply_Clicked" Padding="10,2" IsEnabled="False" />
                <Button x:Name="RestoreButton" Text="Restore" Clicked="Restore_Clicked" Padding="10,2" IsEnabled="False" />
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,470">
            <ScrollView Grid.Column="0" Orientation="Both" BackgroundColor="#101018" Padding="12">
                <views:CharsetView x:Name="Charset" HorizontalOptions="Start" VerticalOptions="Start" />
            </ScrollView>

            <ScrollView Grid.Column="1" Style="{StaticResource SidePanel}">
                <VerticalStackLayout Padding="10,8" Spacing="2">
                    <Label Text="Character set" FontAttributes="Bold" Margin="0,0,0,4" />
                    <Label x:Name="SetText" Style="{StaticResource Mono}" Margin="0,0,0,12" />

                    <Label Text="Selected character" FontAttributes="Bold" Margin="0,0,0,4" />
                    <HorizontalStackLayout Spacing="14" Margin="0,0,0,6">
                        <views:GlyphView x:Name="Glyph" WidthRequest="120" HeightRequest="120" VerticalOptions="Start" />
                        <Label x:Name="BytesText" Style="{StaticResource Mono}" VerticalOptions="Start" />
                    </HorizontalStackLayout>
                    <Label x:Name="CharText" Style="{StaticResource Mono}" Margin="0,0,0,12" />

                    <Label Text="Where the character generator lives" FontAttributes="Bold" Margin="0,0,0,4" />
                    <Label x:Name="NotesText" Style="{StaticResource Subtle}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Grid Grid.Row="3" Style="{StaticResource StatusBar}" ColumnDefinitions="*,Auto">
            <Label x:Name="StatusText" Grid.Column="0" Text="Click a character, or use the arrow keys, to see its codes and addresses." VerticalOptions="Center" />
            <Label x:Name="HoverText" Grid.Column="1" Style="{StaticResource Subtle}" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
