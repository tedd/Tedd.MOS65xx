<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tedd.MOS65xx.Maui.Pages.SpriteViewerPage"
             Title="Sprite Viewer"
             Unloaded="Page_Unloaded">
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="280,*,440">

        <!-- Toolbar -->
        <ScrollView Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource ToolBar}">
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="FreezeButton" Text="Freeze" Clicked="Freeze_Clicked" Padding="10,2" />
                <Button Text="Refresh" Clicked="Refresh_Clicked" Padding="10,2" />
                <CheckBox x:Name="AutoRefresh" IsChecked="True" VerticalOptions="Center" />
                <Label Text="Auto refresh" VerticalOptions="Center" />
                <Label Text="Zoom" VerticalOptions="Center" Margin="8,0,0,0" />
                <Picker x:Name="ZoomBox" WidthRequest="80" SelectedIndexChanged="ViewOption_Changed">
                    <Picker.Items>
                        <x:String>2x</x:String>
                        <x:String>4x</x:String>
                        <x:String>8x</x:String>
                        <x:String>12x</x:String>
                        <x:String>16x</x:String>
                        <x:String>24x</x:String>
                    </Picker.Items>
                </Picker>
                <CheckBox x:Name="GridBox" IsChecked="True" VerticalOptions="Center" CheckedChanged="ViewOption_Changed" />
                <Label Text="Grid" VerticalOptions="Center" />
                <CheckBox x:Name="ExpandBox" IsChecked="True" VerticalOptions="Center" CheckedChanged="ViewOption_Changed" />
                <Label Text="Expansion" VerticalOptions="Center" />
                <CheckBox x:Name="BackgroundBox" VerticalOptions="Center" CheckedChanged="ViewOption_Changed" />
                <Label Text="$D021 backdrop" VerticalOptions="Center" />
                <Button Text="Save PNG..." Clicked="SavePng_Clicked" Padding="10,2" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Sprite list -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}" Margin="6">
            <Grid RowDefinitions="Auto,*">
                <Label Grid.Row="0" Text="Sprites (0 is in front)" Style="{StaticResource Header}" />
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout x:Name="SpriteList" Spacing="2" />
                </ScrollView>
            </Grid>
        </Border>

        <!-- Preview and screen layout -->
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,240" Margin="0,6,0,6" RowSpacing="6">
            <Border Grid.Row="0" Style="{StaticResource Panel}">
                <Grid RowDefinitions="*,Auto">
                    <ScrollView Grid.Row="0" Orientation="Both">
                        <GraphicsView x:Name="Preview" HorizontalOptions="Center" VerticalOptions="Center" Margin="4" />
                    </ScrollView>
                    <Label x:Name="PreviewCaption" Grid.Row="1" Margin="0,6,0,0"
                           HorizontalTextAlignment="Center" Style="{StaticResource SubtleMono}" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Panel}">
                <Grid RowDefinitions="Auto,*">
                    <Label Grid.Row="0" Text="Position on screen (grey box = 40 x 25 display window)" Style="{StaticResource Header}" />
                    <GraphicsView x:Name="LayoutView" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>

        <!-- Detail -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Margin="0,6,6,6">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <Label x:Name="DetailHeader" Grid.Row="0" Text="Sprite 0" Style="{StaticResource Header}" />
                <Label x:Name="DetailText" Grid.Row="1" Style="{StaticResource Mono}" Margin="0,0,0,6" />
                <Label Grid.Row="2" Text="Data (3 bytes per line)" Style="{StaticResource Header}" />
                <ScrollView Grid.Row="3" Orientation="Both">
                    <Label x:Name="DataText" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                </ScrollView>
            </Grid>
        </Border>

        <!-- Registers -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Margin="6,0,6,6">
            <VerticalStackLayout>
                <Label Text="Sprite registers" Style="{StaticResource Header}" />
                <Label x:Name="GlobalText" Style="{StaticResource Mono}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
