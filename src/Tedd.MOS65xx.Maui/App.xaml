<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tedd.MOS65xx.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The tool windows are dense tables of hex and register values: a monospaced face everywhere. -->
            <x:String x:Key="MonoFont">Consolas</x:String>

            <!--
                Chrome shared by the tool windows. Every colour here is an AppThemeBinding, so the whole app
                follows the system light/dark setting; the few surfaces that stay dark in both themes (the
                emulator picture's surround, the glyph and sprite canvases, the oscilloscope) do so on purpose,
                because they are pictures rather than UI.
            -->
            <Style x:Key="ToolBar" TargetType="ScrollView">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0F0F0, Dark=#2B2B2B}" />
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Padding" Value="8,6" />
            </Style>

            <Style x:Key="StatusBar" TargetType="Grid">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EDEDED, Dark=#2B2B2B}" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#C0C0C0, Dark=#4A4A4A}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F4F4F4, Dark=#232323}" />
            </Style>

            <Style x:Key="SidePanel" TargetType="ScrollView">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAFAFA, Dark=#1E1E1E}" />
            </Style>

            <Style x:Key="Header" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="Mono" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- Secondary text: hints, hover readouts, the notes panel. -->
            <Style x:Key="Subtle" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#505050, Dark=#A8A8A8}" />
            </Style>

            <Style x:Key="SubtleMono" TargetType="Label" BasedOn="{StaticResource Mono}">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#505050, Dark=#A8A8A8}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
