<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Blazor WebAssembly front-end: the whole emulator runs client-side in the browser (no server).
    Publish with:  dotnet publish src/Tedd.MOS65xx.Web -c Release -o <dir>
    The Release configuration AOT-compiles the emulator to WebAssembly (needs the "wasm-tools" workload:
    dotnet workload install wasm-tools). Without AOT the Mono interpreter is far too slow for a cycle-exact
    C64, so Debug builds are only useful for UI work.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tedd.MOS65xx.Web</RootNamespace>
    <!-- [JSImport]/[JSExport] source generators need unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
    <!-- Smaller download: no ICU data (the UI is English only), no debug symbols in the published app. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- GitHub Pages does not serve the pre-compressed .br/.gz variants, so do not produce them. -->
    <CompressionEnabled>false</CompressionEnabled>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    AOT needs the wasm-tools workload. To publish Release without it (e.g. to check the site, not the speed):
      dotnet publish -c Release -p:RunAOTCompilation=false -p:WasmStripILAfterAOT=false
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0-preview.7.26381.103" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tedd.MOS65xx.Hosting\Tedd.MOS65xx.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ROM images under wwwroot/roms are git-ignored (see tools/fetch-openroms.*) but published when present. -->
    <Content Update="wwwroot\roms\*.bin" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="wwwroot\roms\c128\*.bin" CopyToPublishDirectory="PreserveNewest" />
    <!-- The C128 CP/M 3.0 disks (disks/c128 in the repository) are served at disks/c128/ for the "boot CP/M" menu. -->
    <Content Include="..\..\disks\c128\*.d64;..\..\disks\c128\README.md" Link="wwwroot\disks\c128\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
